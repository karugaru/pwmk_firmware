set(PICO_BOARD "{{ cmake.board }}" CACHE STRING "Board type" FORCE)
set(PWMK_ENABLE_USB {{ cmake.enable_usb | cmake_bool }} CACHE BOOL "Build USB HID transport" FORCE)
set(PWMK_ENABLE_BLE {{ cmake.enable_ble | cmake_bool }} CACHE BOOL "Build BLE transport" FORCE)
set(PWMK_PROFILE_GENERATED_SRC_DIR "{{ generated_src_dir }}")
